PORT=3000

# Lấy từ Bitrix24 > Developer resources > Other > Local application
CLIENT_ID=local.xxxxxxxxxxxx.xxxxxxxx
CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BITRIX24_DOMAIN=your-portal.bitrix24.com

# Preset của requisite (crm.requisite.preset.list), thường là 1
BITRIX24_REQUISITE_PRESET_ID=1

# API key để gọi /contacts (header x-api-key)
API_KEY=change-me
